+
+static ssize_t charge_control_end_threshold_show(struct device *dev,
+				struct device_attribute *attr, char *sysfsbuf)
+{
+	u8 limit;
+	int ret;
+
+	ret = applesmc_read_key(CHARGE_LIMIT_KEY, &limit, 1);
+	if (ret)
+		return ret;
+
+	return sysfs_emit(sysfsbuf, "%u\n", limit);
 }
 
+static ssize_t charge_control_end_threshold_store(struct device *dev,
+				struct device_attribute *attr,
+				const char *sysfsbuf, size_t count)
+{
+	u8 limit;
+	int ret;
+
+	if (kstrtou8(sysfsbuf, 10, &limit) < 0
+	    || limit < CHARGE_LIMIT_MIN || limit > 100)
+		return -EINVAL;
+
+	ret = applesmc_write_key(CHARGE_LIMIT_KEY, &limit, 1);
+	if (ret)
+		return ret;
+
+	return count;
+}
+
+static DEVICE_ATTR_RW(charge_control_end_threshold);
+
+static int applesmc_create_charge_limit(void)
+{
+	if (!smcreg.has_charge_limit)
+		return 0;
+	return device_create_file(&pdev->dev,
+				  &dev_attr_charge_control_end_threshold);
+}
+
+static void applesmc_release_charge_limit(void)
+{
+	if (!smcreg.has_charge_limit)
+		return;
+	device_remove_file(&pdev->dev, &dev_attr_charge_control_end_threshold);
+}
