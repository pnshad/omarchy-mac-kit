#!/usr/bin/env bash
# omk-rainpass: one rain pass over the screen (omarchy-mac-kit), the hourly pixel refresh for an
# hwdeck wall. Runs only while an hwdeck view is open and the panel is on (--force skips both).
# The overlay is a full-screen, opaque foot window (the rainpass Hyprland rule). When it ends,
# omk-screensaver touches $XDG_RUNTIME_DIR/omk-refreshed (a Touch Bar strip shows REFRESHED).
#   omk-rainpass [--force] [--lock]
set -u
eval "$(systemctl --user show-environment | grep -E '^(WAYLAND_DISPLAY|XDG_RUNTIME_DIR|HYPRLAND_INSTANCE_SIGNATURE|DISPLAY|XDG_CURRENT_DESKTOP|PATH)=' | sed 's/^/export /')"
# --lock (the Touch Bar lock key): a short pass with the glitch early, then the screen locks
lock=""
[[ " $* " == *" --lock "* ]] && lock=--lock
if [[ ${1:-} != --force ]]; then
  grep -qs On /sys/class/drm/*eDP*/dpms || exit 0
  hyprctl clients -j | grep -q "\"class\": \"${OMK_APP_ID_PREFIX:-org.omk}.hwdeck-" || exit 0
fi
if pgrep -f -- '--app-id=org.omk.rainpass' >/dev/null; then
  [[ -n $lock ]] && OMARCHY_PATH=${OMARCHY_PATH:-/usr/share/omarchy} omarchy-system-lock
  exit 0
fi
export OMARCHY_PATH=${OMARCHY_PATH:-/usr/share/omarchy}
# Take the whole screen: Omarchy's bar is a layer above every window, so hide it for the pass
# (only if it was showing) and bring it back afterwards.
flag=$HOME/.local/state/omarchy/toggles/bar-off
hid=0
if [[ ! -e $flag ]]; then
  mkdir -p "${flag%/*}" && touch "$flag" && hid=1
  omarchy-shell -q omarchy.bar syncHidden
fi
# The window rule should make it full screen, but a pass has opened tiled (a sixth of the screen,
# among the deck wall) at least once: check the window and force it when the rule did not take.
# In the background, started before the window: uwsm-app below waits until foot exits.
(
  for _ in $(seq 80); do                     # up to 8 s for foot to map the window
    win=$(hyprctl clients -j | jq -c '.[] | select(.class == "org.omk.rainpass") | {address, floating, fullscreen}' | head -1)
    if [[ -n $win ]]; then
      addr=$(jq -r .address <<<"$win")
      if [[ $(jq -r .floating <<<"$win") != true || $(jq -r .fullscreen <<<"$win") == 0 ]]; then
        hyprctl dispatch "hl.dsp.window.float({ action = \"on\", window = \"address:$addr\" })" >/dev/null
        hyprctl dispatch "hl.dsp.window.fullscreen({ mode = \"fullscreen\", window = \"address:$addr\" })" >/dev/null
        echo "omk-rainpass: window was not full screen ($win), forced" >&2
      fi
      break
    fi
    sleep 0.1
  done
) &
uwsm-app -- foot --app-id=org.omk.rainpass -o colors-dark.background=000000 \
  -o main.pad=0x0 -o "main.font=${OMK_RAIN_FONT:-JetBrainsMono Nerd Font}:size=20" \
  -e "$(dirname "$(readlink -f "$0")")/omk-screensaver" --pass 9 $lock
sleep 1
for _ in $(seq 60); do
  pgrep -f -- '--app-id=org.omk.rainpass' >/dev/null || break
  sleep 0.5
done
if (( hid )); then
  rm -f "$flag"
  omarchy-shell -q omarchy.bar syncHidden
fi
