#!/usr/bin/env python3
"""omk-screensaver - an endless digital-rain screensaver for Omarchy (omarchy-mac-kit).

Runs inside the terminal Omarchy opens for its screensaver (class org.omarchy.screensaver), in
place of Omarchy's ttfx logo effects. Same exit rules as Omarchy's script: any key, or the window
losing focus (mouse moved), closes every screensaver window and shows the cursor again.
Standard library only. `omk-screensaver --demo` runs it in any terminal (any key quits).
As the idle screensaver it hands over to omk-deckwall (the live hwdeck wall) when that is
installed; `--rain` keeps the plain full-screen rain. `--pass N` is one rain pass over the screen
(used by omk-rainpass); `--lock` with it: a short pass, then lock.
"""
import json
import os
import random
import select
import shutil
import signal
import subprocess
import sys
import termios
import time
import tty

GLYPHS = "ｱｲｳｴｵｶｷｸｹｺｻｼｽｾｿﾀﾁﾂﾃﾄﾅﾆﾇﾈﾉﾊﾋﾌﾍﾎﾏﾐﾑﾒﾓﾔﾕﾖﾗﾘﾙﾚﾛﾜﾝ012345789Z:.=*+-<>|"
FPS = 20
BLANK = "\033[49m" if "--pass" in sys.argv else ""   # erase to the transparent default background
# head, then the trail from bright to dark (256-colour greens)
HEAD = "\033[1;38;2;255;255;255m"                          # the clock's white, fading to grey
TRAIL = ["\033[1;38;2;242;242;242m", "\033[38;2;205;205;205m", "\033[38;2;165;165;165m",
         "\033[38;2;125;125;125m", "\033[38;2;88;88;88m", "\033[38;2;55;55;55m"]
# the glitch: a pass ends on a white column glitching red as it falls, as if hacked; when it has left the screen, the end
HEAD_R = "\033[1;38;2;255;90;80m"
TRAIL_R = ["\033[1;38;2;240;60;52m", "\033[38;2;210;45;40m", "\033[38;2;170;35;32m",
           "\033[38;2;130;26;24m", "\033[38;2;92;18;17m", "\033[38;2;58;12;11m"]
GLITCH_S = 1.6
WHITE_GLITCH_S = 0.5                        # a hacked column scrambles white this long, then turns red
LOCK = "--lock" in sys.argv                 # a pass from the lock key: short, then lock
DEMO = "--demo" in sys.argv
# --pass SECONDS: one rain pass over whatever is on screen (the hourly pixel refresh over the hwdeck
# wall): transparent background in a click-through overlay, no exit on focus or keys, new drops
# stop spawning near the end so the screen drains clean, then it exits.
PASS = float(sys.argv[sys.argv.index("--pass") + 1]) if "--pass" in sys.argv else None


def hypr(*args):
    try:
        return subprocess.run(["hyprctl", *args], capture_output=True, text=True, timeout=2).stdout
    except (OSError, subprocess.SubprocessError):
        return ""


def in_focus():
    try:
        return json.loads(hypr("activewindow", "-j") or "{}").get("class") == "org.omarchy.screensaver"
    except ValueError:
        return True                      # cannot tell: keep running rather than flicker out


def cursor(invisible):
    v = "true" if invisible else "false"
    if not hypr("eval", f"hl.config({{ cursor = {{ invisible = {v} }} }})").strip():
        hypr("keyword", "cursor:invisible", v)


class Rain:
    """One drop per (even) column: a white head writing new glyphs, a trail that keeps its glyphs
    and fades from bright to dark green, erased behind the tail. Only trail cells are rewritten."""

    def __init__(self, cols, rows, erase=None, trail=None):
        self.cols, self.rows = cols, rows
        self.erase = BLANK if erase is None else erase          # what a cell becomes behind a tail
        self.trail = trail                                      # (min, max) trail length, or None
        self.grid = [[" "] * rows for _ in range(cols)]
        self.drops = {c: self.new(start=True) for c in range(0, cols - 1, 2)}
        self.draining = False
        self.glitch = None                  # (column, until) while one column is hacked
        self.ghosts = []                    # stray red glyphs beside it, wiped the next frame

    def hack(self, col=None, secs=GLITCH_S):
        """Turn one column red for `secs`: `col`, or a drop whose head is in the middle of the
        screen, so the whole glitch is seen. False when no drop is there yet."""
        mid = [c for c, d in self.drops.items() if self.rows * 0.3 < d[0] < self.rows * 0.75]
        if col is None and not mid:
            return False
        now = time.time()
        self.glitch = (random.choice(mid) if col is None else col, now + secs, now + WHITE_GLITCH_S)
        return True

    def new(self, start=False):
        # [head row (float), rows per frame, trail length, last drawn head row]
        head = random.uniform(-self.rows, 0) if start else random.uniform(-self.rows / 3, 0)
        lo, hi = self.trail or (8, max(10, self.rows * 3 // 4))
        return [head, random.uniform(0.15, 0.55), random.randint(lo, hi), int(head)]

    def frame(self):
        out = []
        for r, c in self.ghosts:                        # last frame's stray glyphs go
            out.append(f"\033[{r + 1};{c + 1}H{self.erase} ")
        self.ghosts = []
        hacked = self.glitch[0] if self.glitch and time.time() < self.glitch[1] else None
        if self.glitch and hacked is None:
            self.glitch = None
        for c, d in self.drops.items():
            d[0] += d[1]
            h, length, prev = int(d[0]), d[2], d[3]
            for row in range(max(0, prev + 1), min(self.rows, h + 1)):
                self.grid[c][row] = random.choice(GLYPHS)
            if random.random() < 0.08:                   # a glyph in the trail flickers
                row = h - random.randint(1, length)
                if 0 <= row < self.rows:
                    self.grid[c][row] = random.choice(GLYPHS)
            glitchy = c == hacked                           # scrambling: first white, then red
            red = glitchy and time.time() >= self.glitch[2]
            for k in range(length + 1):
                row = h - k
                if 0 <= row < self.rows:
                    if glitchy and random.random() < 0.45:  # hacked: the glyphs scramble
                        self.grid[c][row] = random.choice(GLYPHS)
                    head, trail = (HEAD_R, TRAIL_R) if red else (HEAD, TRAIL)
                    colour = head if k == 0 else trail[min(len(trail) - 1, (k - 1) * len(trail) // length)]
                    out.append(f"\033[{row + 1};{c + 1}H{colour}{self.grid[c][row]}")
            if red:                                         # and a few spill sideways for a frame
                for _ in range(random.randint(0, 3)):
                    row, cc = h - random.randint(0, length), c + random.choice((-1, 1))
                    if 0 <= row < self.rows and 0 <= cc < self.cols:
                        out.append(f"\033[{row + 1};{cc + 1}H{random.choice(TRAIL_R[:3])}{random.choice(GLYPHS)}")
                        self.ghosts.append((row, cc))
            for row in range(max(0, prev - length), min(self.rows, h - length)):
                out.append(f"\033[{row + 1};{c + 1}H{self.erase}  ")
            d[3] = h
            if h - length >= self.rows and not self.draining:
                self.drops[c] = self.new()
        return "".join(out)


class Takeover:
    """The --pass effect, film style: every column rains down with a white head, a bright green glow
    and a trail that settles into code of mixed depth, until the screen is solid code; it holds with
    glyphs flickering and changing; then it decodes top to bottom: white heads fall and the code
    above them fades through the greens before the live screen shows through. 24-bit colour, and only
    the cells that change are written."""
    # The clock's white on deep black: white heads, a glow of near-whites, settled code in greys
    BG = "\033[48;2;0;0;0m"
    HEAD = BG + "\033[1;38;2;255;255;255m"
    GLOW = [BG + "\033[1;38;2;242;242;242m", BG + "\033[38;2;215;215;215m", BG + "\033[38;2;185;185;185m"]
    DEPTH = [BG + "\033[38;2;160;160;160m", BG + "\033[38;2;128;128;128m", BG + "\033[38;2;100;100;100m",
             BG + "\033[38;2;74;74;74m"]                # settled code, near to far
    FADE = [BG + "\033[38;2;90;90;90m", BG + "\033[38;2;52;52;52m", BG + "\033[38;2;26;26;26m"]
    GAP = 2                                              # code in every other column

    def __init__(self, cols, rows, fill=4.6, hold=1.6, reveal=5.0):
        self.cols, self.rows = cols, rows
        self.t_fill, self.t_hold = fill, hold
        self.fill = [(random.uniform(0, fill * 0.45), random.uniform(fill * 0.35, fill * 0.55))
                     for _ in range(cols)]
        self.reveal = [(random.uniform(0, reveal * 0.35), random.uniform(reveal * 0.4, reveal * 0.6))
                       for _ in range(cols)]
        self.glyph = [[random.choice(GLYPHS) for _ in range(rows)] for _ in range(cols)]
        self.depth = [[random.choice(self.DEPTH) for _ in range(rows)] for _ in range(cols)]
        self.filled = [0] * cols
        self.cleared = [0] * cols
        self.done_at = fill + hold + reveal

    def cell(self, out, c, r, colour, new=False):
        if c % self.GAP:                                 # a gap column: deep black, no code
            if 0 <= r < self.rows:
                out.append(f"\033[{r + 1};{c + 1}H{self.BG} ")
            return
        if 0 <= r < self.rows:
            if new:
                self.glyph[c][r] = random.choice(GLYPHS)
            out.append(f"\033[{r + 1};{c + 1}H{colour}{self.glyph[c][r]}")

    def frame(self, t):
        out = []
        rt = t - self.t_fill - self.t_hold
        for c in range(self.cols):
            start, span = self.fill[c]
            head = min(self.rows, int((t - start) / span * self.rows)) if t > start else 0
            if head > self.filled[c] or 0 < head < self.rows:
                for r in range(self.filled[c], head):   # new code under the trail
                    self.cell(out, c, r, self.DEPTH[0], new=True)
                for k, colour in enumerate(self.GLOW, 1):  # the glow behind the head
                    if head - k >= 0:
                        self.cell(out, c, head - k, colour)
                if head - 4 >= 0:                       # settles into its own depth
                    self.cell(out, c, head - 4, self.depth[c][head - 4])
                if head < self.rows:
                    self.cell(out, c, head, self.HEAD, new=True)
                self.filled[c] = head
            if rt > 0:
                start, span = self.reveal[c]
                head = min(self.rows + 3, int((rt - start) / span * (self.rows + 3))) if rt > start else 0
                if head > self.cleared[c]:
                    for r in range(max(0, self.cleared[c] - 3), max(0, head - 3)):   # gone: live screen
                        out.append(f"\033[{r + 1};{c + 1}H{BLANK} ")
                    for k, colour in enumerate(self.FADE, 1):   # fading just above the head
                        if 0 <= head - k < self.rows:
                            self.cell(out, c, head - k, colour)
                    if head < self.rows:
                        self.cell(out, c, head, self.HEAD, new=True)
                    self.cleared[c] = head
        for _ in range(self.cols * self.rows // 45):    # code flickers and changes where it stands
            c, r = random.randrange(self.cols), random.randrange(self.rows)
            if c % self.GAP == 0 and self.cleared[c] + 1 <= r < self.filled[c] - 4:
                if random.random() < 0.12:
                    self.cell(out, c, r, self.GLOW[1], new=True)
                else:
                    self.depth[c][r] = random.choice(self.DEPTH)
                    self.cell(out, c, r, self.depth[c][r], new=random.random() < 0.5)
        return "".join(out)


def main():
    fd = sys.stdin.fileno()
    old = termios.tcgetattr(fd)
    w = sys.stdout.write

    def finish(*_):
        termios.tcsetattr(fd, termios.TCSADRAIN, old)
        w("\033[0m\033[2J\033[?25h\033[?1049l")
        sys.stdout.flush()
        if not DEMO and PASS is None:
            cursor(False)
            subprocess.run(["pkill", "-f", "[o]rg.omarchy.screensaver"], check=False)
        sys.exit(0)

    for sig in (signal.SIGINT, signal.SIGTERM, signal.SIGHUP, signal.SIGQUIT):
        signal.signal(sig, finish)
    # As the idle screensaver (no flags): hand the screen to the hwdeck wall. This window only
    # holds deep black (no rain of its own, or the pass would look like a restart) while
    # omk-deckwall starts the pass on top and then closes this window. --rain keeps plain rain.
    wall = os.path.join(os.path.dirname(os.path.abspath(__file__)), "omk-deckwall")
    hand_over = not DEMO and PASS is None and "--rain" not in sys.argv and os.access(wall, os.X_OK)
    if hand_over:
        subprocess.Popen([wall], stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL,
                         stderr=subprocess.DEVNULL, start_new_session=True)
    tty.setcbreak(fd)
    if PASS is None:                          # true black (24-bit): ANSI 40 is the theme's dark grey
        size0 = shutil.get_terminal_size()
        w("\033]11;rgb:00/00/00\007\033[?1049h\033[?25l\033[48;2;0;0;0m\033[2J"
          + "".join(f"\033[{r + 1};1H{' ' * size0.columns}" for r in range(size0.lines)))
        sys.stdout.flush()
    if hand_over:                             # wait in black until the wall takes over (or a key)
        cursor(True)
        while True:
            if select.select([fd], [], [], 0.25)[0]:
                finish()
    else:
        w("\033[?1049h\033[?25l\033[49m\033[2J")
    started = time.time()
    if not DEMO:
        if PASS is None:
            cursor(True)
        deadline = time.time() + 2               # the pty starts 80x24 until the window sizes it
        while time.time() < deadline and shutil.get_terminal_size() == (80, 24):
            time.sleep(0.02)
    size = shutil.get_terminal_size()
    rain = Rain(size.columns, size.lines)
    if PASS is not None:                        # black, Touch Bar style rain, drain, straight back
        cols, rows = size.columns, size.lines
        black = "\033[48;2;0;0;0m"
        w("".join(f"\033[{r + 1};1H{black}{' ' * cols}" for r in range(rows)))   # 1. deep black
        sys.stdout.flush()
        time.sleep(0.5)
        drops = Rain(cols, rows, erase=black, trail=(6, max(8, rows // 2)))      # 2. the rain
        t_rain = time.time()
        col = None
        while True:
            t0 = time.time()
            drops.draining = t0 - t_rain > (3.2 if LOCK else 5.5)                # 3. stop spawning
            if drops.draining and col is None:
                # 4. the ending: a white column in the upper half, falling at its own speed like
                # the rest, glitches, turns red and keeps going; when its tail has left the bottom
                # of the screen, everything ends. The one that is gone in about 3 s.
                cand = [(c, d) for c, d in drops.drops.items() if 0 <= d[0] < rows * 0.6 and d[1] > 0]
                if cand:
                    col = min(cand, key=lambda cd: abs((rows + cd[1][2] - cd[1][0]) / cd[1][1] / FPS - 3.0))[0]
                    drops.hack(col, 60)
                else:
                    col = -1                                                     # nothing to hack
            w(drops.frame())
            sys.stdout.flush()
            if col is not None and col >= 0 and drops.drops[col][0] - drops.drops[col][2] >= rows:
                break                                                            # it has left the screen
            if col == -1 and all(d[0] - d[2] >= rows for d in drops.drops.values()):
                break
            if t0 - t_rain > 30:
                break
            time.sleep(max(0, 1 / FPS - (time.time() - t0)))
        # 5. the rain has drained: go straight back (the window closes, the live screen is there);
        # from the lock key, lock first, so the lock screen comes up over the black
        if not LOCK:                            # a Touch Bar strip watching this file shows REFRESHED
            try:
                with open(os.path.join(os.environ.get("XDG_RUNTIME_DIR", f"/run/user/{os.getuid()}"),
                                       "omk-refreshed"), "w") as f:
                    f.write(str(time.time()))
            except OSError:
                pass
        if LOCK:
            omarchy = os.environ.get("OMARCHY_PATH", "/usr/share/omarchy")
            env = dict(os.environ, OMARCHY_PATH=omarchy)
            env["PATH"] = f"{omarchy}/bin:" + env.get("PATH", "/usr/bin")
            lock = f"{omarchy}/bin/omarchy-system-lock"
            subprocess.Popen([lock] if os.access(lock, os.X_OK) else ["loginctl", "lock-session"],
                             env=env, start_new_session=True,
                             stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
            time.sleep(0.6)
        finish()
    next_focus = time.time() + 1.5
    while True:
        start = time.time()
        if shutil.get_terminal_size() != size:
            size = shutil.get_terminal_size()
            rain = Rain(size.columns, size.lines)
            w("\033[2J")
        w(rain.frame())
        sys.stdout.flush()
        ready = select.select([fd], [], [], max(0, 1 / FPS - (time.time() - start)))[0]
        if PASS is not None:
            rain.draining = time.time() - started > PASS * 0.55
            if time.time() - started > PASS:
                finish()
            continue
        if ready:
            finish()
        if not DEMO and time.time() >= next_focus:
            if not in_focus():
                finish()
            next_focus = time.time() + 1


if __name__ == "__main__":
    main()
