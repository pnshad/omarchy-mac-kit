#!/usr/bin/env python3
"""omk-deckwall - the idle screensaver as a live hwdeck wall (omarchy-mac-kit).

Omarchy's idle service opens its screensaver terminal, which runs omarchy-screensaver (the user
override in ~/.local/share/omk/bin), which runs omk-screensaver, which hands over to this. It:
  1. opens any of the six hwdeck views that are not open (they float in their grid: the wall module),
     behind Omarchy's full-screen black saver window, and waits until they are mapped,
  2. then starts the rain pass, so its window is the newest and sits above the views (started
     first, the views popped up over the rain for a moment),
  3. once the pass window is up, closes Omarchy's (black, empty) screensaver window under it, so the
     reveal shows the live deck wall,
  4. waits until the session is no longer idle, then closes the views it opened itself.
The lock still comes at Omarchy's lock timeout. Any failure falls back to the plain rain screensaver.
"""
import json
import os
import subprocess
import sys
import time

HOME = os.path.expanduser("~")
VIEWS = ["cpu", "thermal", "network", "memory", "power", "battery"]
HERE = os.path.dirname(os.path.abspath(__file__))
HWDECK = os.path.join(HERE, "hwdeck")
RAINPASS = os.path.join(HERE, "omk-rainpass")
APP = os.environ.get("OMK_APP_ID_PREFIX", "org.omk")


def session_env():
    env = dict(os.environ)
    out = subprocess.run(["systemctl", "--user", "show-environment"], capture_output=True,
                         text=True).stdout
    for line in out.splitlines():
        k, _, v = line.partition("=")
        if k and not v.startswith("$'"):
            env[k] = v
    env.setdefault("OMARCHY_PATH", "/usr/share/omarchy")
    return env


ENV = session_env()


def run(*cmd, **kw):
    return subprocess.run(list(cmd), capture_output=True, text=True, env=ENV, timeout=10, **kw)


def clients():
    try:
        return json.loads(run("hyprctl", "clients", "-j").stdout or "[]")
    except (ValueError, subprocess.SubprocessError, OSError):
        return []


def spawn(*cmd):
    subprocess.Popen(list(cmd), env=ENV, stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL,
                     stderr=subprocess.DEVNULL, start_new_session=True)


def idle():
    try:
        return json.loads(run("omarchy-shell", "idle", "status").stdout).get("idle", False)
    except (ValueError, subprocess.SubprocessError, OSError):
        return False


def main():
    open_now = {c.get("class") for c in clients()}
    opened = []
    for v in VIEWS:
        app = f"{APP}.hwdeck-{v}"
        if app not in open_now:
            spawn("uwsm-app", "--", "xdg-terminal-exec", f"--app-id={app}", "-e", HWDECK, "--view", v)
            opened.append(app)
    # the views first, hidden behind the full-screen saver; then the pass on top of them
    for _ in range(50):
        if all(a in {c.get("class") for c in clients()} for a in opened):
            break
        time.sleep(0.1)
    spawn(RAINPASS, "--force")
    # once the pass window is up (black over everything), drop Omarchy's black saver window under it
    for _ in range(80):
        if any(c.get("class") == "org.omk.rainpass" for c in clients()):
            break
        time.sleep(0.1)
    time.sleep(0.6)
    run("pkill", "-f", "[o]rg.omarchy.screensaver")
    run("hyprctl", "eval", "hl.config({ cursor = { invisible = false } })")
    # Keep the wall while idle; when the user is back, close what we opened.
    time.sleep(5)
    while idle():
        time.sleep(1)
    for c in clients():
        if c.get("class") in opened and c.get("address"):
            run("hyprctl", "dispatch", f'hl.dsp.window.close({{ window = "address:{c["address"]}" }})')


if __name__ == "__main__":
    if os.fork():                                    # detach from the saver terminal
        sys.exit(0)
    os.setsid()
    main()
